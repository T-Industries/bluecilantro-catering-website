# ---------- Server ----------
PORT=4000
# Public URL of the site (used in email/SMS links). Production: https://your-domain
APP_URL="http://localhost:5173"

# ---------- Database (PostgreSQL) ----------
# Local (docker compose up -d):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bluecilantro"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/bluecilantro"
# Production (Neon): DATABASE_URL = the *pooled* connection string (host contains "-pooler"),
#                    DIRECT_URL   = the direct connection string. Both end with ?sslmode=require

# Event dates/times are interpreted in this timezone (servers like Vercel run in UTC)
BUSINESS_TIMEZONE="America/Edmonton"

# ---------- Admin ----------
# Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-32chars-min"
# Super admin created by the seed script (can manage every restaurant)
SUPER_ADMIN_EMAIL="admin@bluecilantro.ca"
SUPER_ADMIN_PASSWORD="ChangeMe123!"

# ---------- Notifications ----------
# Fallback recipients used when a restaurant has no notification email/phone set in the admin panel.
# Also CC'd on every order (leave blank to disable).
OPS_NOTIFY_EMAIL=""
OPS_NOTIFY_PHONE=""

# SMTP2Go email (https://www.smtp2go.com). If not set, emails are printed to the console.
SMTP2GO_API_KEY=""
SMTP2GO_SENDER_EMAIL="orders@bluecilantro.ca"
SMTP2GO_SENDER_NAME="BlueCilantro Catering"

# Twilio SMS (https://www.twilio.com). If not set, SMS messages are printed to the console.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Either a Twilio phone number in E.164 format (+15875551234) or a Messaging Service SID (MG...)
TWILIO_FROM_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""
# Country code assumed for 10-digit phone numbers
DEFAULT_COUNTRY_CODE="+1"
